# --- Required in production -------------------------------------------------
# API key for the OpenAI-compatible provider (OpenAI, or OpenRouter when
# OPENAI_BASE_URL points at it).
OPENAI_API_KEY=

# --- Provider selection -------------------------------------------------------
# Default: OpenAI Responses API with model gpt-5.4.
# For OpenRouter, set all three (OpenRouter speaks the Chat Completions API):
# OPENAI_BASE_URL=https://openrouter.ai/api/v1
# OPENAI_API_MODE=chat
# OPENAI_MODEL=openai/gpt-5.4

# --- Optional -------------------------------------------------------------------
# Port the Express server listens on (Railway injects PORT; 8000 is the default).
# PORT=8000
# Where the SQLite store lives. Defaults to agent/data/rpg.db (created and seeded
# on first start). On Railway, point this at a mounted volume so data survives
# redeploys.
# RPG_DB_PATH=/data/rpg.db

# --- Integrations (MVP) ------------------------------------------------------------
# QuickBooks, the order inbox, supplier BOL feeds, and market index feeds are all
# served from sample JSON in agent/samples/. No credentials are needed; see the
# README for how each sample is used and where the real integration would plug in.
