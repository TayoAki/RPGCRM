# --- Required in production -------------------------------------------------
# API key for the OpenAI-compatible provider (OpenAI, or OpenRouter when
# OPENAI_BASE_URL points at it).
OPENAI_API_KEY=
# Tavily web search (lead enrichment). Get a key at https://tavily.com
TAVILY_API_KEY=

# --- Provider selection -------------------------------------------------------
# Default: OpenAI Responses API with model gpt-5.4.
# For OpenRouter, set all three (OpenRouter speaks the Chat Completions API):
# OPENAI_BASE_URL=https://openrouter.ai/api/v1
# OPENAI_API_MODE=chat
# OPENAI_MODEL=openai/gpt-5.4

# --- Optional -------------------------------------------------------------------
# Port the Express server listens on (Railway injects PORT; 8000 is the default).
# PORT=8000
# Where the SQLite store lives. Defaults to agent/src/crm/data/northstar.db.
# On Railway, point this at a mounted volume so data survives redeploys.
# NORTHSTAR_DB_PATH=/data/northstar.db
# Serve canned enrichment results instead of calling Tavily (demo / no key).
# MOCK_TAVILY=1
